      "cell_type": "code",
      "source": [
        "#PRACTICAL 4: Data Preprocessing (Cleaning RAW Data)\n",
        "df = df_raw.copy()\n",
        "\n",
        "# Step 1: Remove Duplicates\n",
        "n_before = len(df)\n",
        "df.drop_duplicates(inplace=True)\n",
        "print(f\"\\n[1/6] Duplicates removed: {n_before - len(df)} → {len(df):,} rows remain\")\n",
        "\n",
        "#  Step 2: Strip whitespace from all column names (catch hidden spaces) ─\n",
        "df.columns = df.columns.str.strip()\n",
        "print(f\"\\n[2/6] Column names stripped of whitespace \")\n",
        "print(f\"       Columns: {df.columns.tolist()}\")\n",
        "\n",
        "#  Step 3: Fix Inconsistent Categorical Values\n",
        "print(\"\\n[3/6] Fixing categorical values...\")\n",
        "cat_fix_cols = [c for c in ['income_type','financial_scenario',\n",
        "                              'cash_flow_status','financial_stress_level',\n",
        "                              'category'] if c in df.columns]\n",
        "for col in cat_fix_cols:\n",
        "    df[col] = df[col].astype(str).str.strip().str.title()\n",
        "    print(f\"   '{col}': {sorted(df[col].dropna().unique())}\")\n",
        "\n",
        "# Step 4: Handle Missing Values\n",
        "print(f\"\\n[4/6] Imputing missing values...\")\n",
        "print(f\"   Total missing before: {df.isnull().sum().sum()}\")\n",
        "\n",
        "# Numeric → median\n",
        "for col in df.select_dtypes(include='number').columns:\n",
        "    n_null = df[col].isnull().sum()\n",
        "    if n_null > 0:\n",
        "        med = df[col].median()\n",
        "        df[col] = df[col].fillna(med)\n",
        "        print(f\"   '{col}': {n_null} NaN → median={med:.2f}\")\n",
        "\n",
        "# Categorical → mode\n",
        "for col in df.select_dtypes(include='object').columns:\n",
        "    n_null = df[col].isnull().sum()\n",
        "    if n_null > 0:\n",
        "        mode_val = df[col].mode()[0]\n",
        "        df[col] = df[col].fillna(mode_val)\n",
        "        print(f\"   '{col}': {n_null} NaN → mode='{mode_val}'\")\n",
        "\n",
        "print(f\"   Total missing after: {df.isnull().sum().sum()} \")\n",
        "\n",
        "#  Step 5: Outlier Treatment (IQR / Winsorize)\n",
        "print(\"\\n[5/6] Outlier treatment (IQR Winsorizing)...\")\n",
        "outlier_cols = [c for c in ['monthly_income','monthly_expense_total',\n",
        "                              'actual_savings','debt_to_income_ratio',\n",
        "                              'credit_score','essential_spending',\n",
        "                              'discretionary_spending','loan_payment',\n",
        "                              'investment_amount']\n",
        "                if c in df.columns]\n",
        "\n",
        "outlier_summary = {}\n",
        "for col in outlier_cols:\n",
        "    Q1  = df[col].quantile(0.25)\n",
        "    Q3  = df[col].quantile(0.75)\n",
        "    IQR = Q3 - Q1\n",
        "    lo  = Q1 - 1.5 * IQR\n",
        "    hi  = Q3 + 1.5 * IQR\n",
        "    n_out = ((df[col] < lo) | (df[col] > hi)).sum()\n",
        "    df[col] = df[col].clip(lower=lo, upper=hi)\n",
        "    outlier_summary[col] = {'Q1':round(Q1,2),'Q3':round(Q3,2),\n",
        "                             'IQR':round(IQR,2),'Lower':round(lo,2),\n",
        "                             'Upper':round(hi,2),'Outliers':n_out}\n",
        "    print(f\"   '{col}': {n_out} outliers capped → [{lo:.2f}, {hi:.2f}]\")\n",
        "\n",
        "outlier_df = pd.DataFrame(outlier_summary).T\n",
        "print(\"\\n\", outlier_df.to_string())\n",
        "outlier_df.to_csv(f\"{OUTPUT_DIR}/p4_outlier_summary.csv\")"
      ],
