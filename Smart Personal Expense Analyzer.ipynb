        "# Recalculate values\n",
        "\n",
        "cols = ['essential_spending','discretionary_spending',\n",
        "        'loan_payment','investment_amount']\n",
        "\n",
        "cols = [c for c in cols if c in df]\n",
        "\n",
        "df['monthly_expense_total'] = df[cols].sum(axis=1)\n",
        "df['net_cash_flow'] = df['monthly_income'] - df['monthly_expense_total']\n",
        "\n",
        "df['savings_rate'] = (df['net_cash_flow'] / df['monthly_income'].replace(0, np.nan)).clip(-1,1)\n",
        "df['savings_pct'] = (df['savings_rate'] * 100).round(2)\n",
        "\n",
        "df['cash_flow_status'] = df['net_cash_flow'].apply(\n",
        "    lambda x: 'Positive' if x>0 else ('Negative' if x<0 else 'Neutral'))\n",
        "\n",
        "df['actual_savings'] = df['net_cash_flow'].clip(lower=0)\n",
        "df['savings_goal_met'] = (df['net_cash_flow'] > 0).astype(int)\n",
        "\n",
        "# Save\n",
        "df.to_csv(f\"{OUTPUT_DIR}/cleaned_data.csv\", index=False)\n",
        "\n",
