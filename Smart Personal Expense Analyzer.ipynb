    {
      "cell_type": "code",
      "source": [
        "# PRACTICAL 6: Apriori Association Rule Mining\n",
        "\n",
        "from mlxtend.preprocessing import TransactionEncoder\n",
        "from mlxtend.frequent_patterns import apriori, association_rules\n",
        "\n",
        "# Copy data\n",
        "df_ap = df.copy()\n",
        "\n",
        "# Create categories\n",
        "df_ap['income_level'] = pd.cut(df_ap['monthly_income'], 3,\n",
        "                              labels=['Low','Mid','High'])\n",
        "\n",
        "df_ap['expense_level'] = pd.cut(df_ap['monthly_expense_total'], 3,\n",
        "                               labels=['Low','Mid','High'])\n",
        "\n",
        "df_ap['savings_level'] = pd.cut(df_ap['savings_rate'],\n",
        "                               [-1,0,0.15,1],\n",
        "                               labels=['Deficit','Low','High'])\n",
        "\n",
        "# Select columns for transactions\n",
        "cols = [c for c in ['income_level','expense_level','savings_level','category']\n",
        "        if c in df_ap.columns]\n",
        "\n",
        "# Convert to transactions\n",
        "transactions = df_ap[cols].astype(str).values.tolist()\n",
        "\n",
        "# Encoding\n",
        "te = TransactionEncoder()\n",
        "df_te = pd.DataFrame(te.fit_transform(transactions), columns=te.columns_)\n",
        "\n",
        "print(\"\\n Transaction Matrix Shape:\", df_te.shape)\n",
        "\n",
        "# Apriori\n",
        "freq = apriori(df_te, min_support=0.05, use_colnames=True)\n",
        "print(\"\\n Frequent Itemsets:\")\n",
        "print(freq.head(10))\n",
        "\n",
        "# Rules\n",
        "rules = association_rules(freq, metric='confidence', min_threshold=0.3)\n",
        "\n",
        "print(\"\\n Association Rules:\")\n",
        "print(rules[['antecedents','consequents','support','confidence','lift']].head(10))\n",
        "\n",
        "# Save rules\n",
        "rules.to_csv(f\"{OUTPUT_DIR}/p6_rules.csv\", index=False)\n",
        "print(f\"\\n Rules saved → {OUTPUT_DIR}/p6_rules.csv\")\n",
        "\n",
        "# Visualization\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "fig, ax = plt.subplots(1, 2, figsize=(12,5))\n",
        "\n",
        "# Scatter plot\n",
        "ax[0].scatter(rules['support'], rules['confidence'], alpha=0.5)\n",
        "ax[0].set_title(\"Support vs Confidence\")\n",
        "ax[0].set_xlabel(\"Support\")\n",
        "ax[0].set_ylabel(\"Confidence\")\n",
        "\n",
        "# Bar chart (Top rules by lift)\n",
        "top_rules = rules.sort_values('lift', ascending=False).head(10)\n",
        "top_rules['lift'].plot(kind='barh', ax=ax[1])\n",
        "ax[1].set_title(\"Top Rules (Lift)\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{OUTPUT_DIR}/p6_viz.png\")\n",
        "plt.show()\n",
        "\n",
        "print(f\" Visualization saved → {OUTPUT_DIR}/p6_viz.png\")"
      ],
