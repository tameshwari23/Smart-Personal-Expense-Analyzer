        "# Model\n",
        "agg = AgglomerativeClustering(n_clusters=4)\n",
        "labels = agg.fit_predict(X)\n",
        "\n",
        "# Add cluster labels\n",
        "df_clust = data.iloc[:len(X)].copy() # Ensure df_clust has the same number of rows as X\n",
        "df_clust['Cluster'] = labels\n",
        "\n",
        "# Cluster Profile\n",
        "profile = df_clust.groupby('Cluster')[cols].mean().round(2)\n",
        "\n",
        "print(\"\\nCluster Profiles:\")\n",
        "print(profile)\n",
        "\n",
        "# Save\n",
        "profile.to_csv(f\"{OUTPUT_DIR}/p8_cluster_profiles.csv\")"
