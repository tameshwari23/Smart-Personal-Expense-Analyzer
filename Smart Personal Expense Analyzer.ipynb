      "source": [
        "# Cluster Naming\n",
        "names = {}\n",
        "\n",
        "for cid in profile.index:\n",
        "    row = profile.loc[cid]\n",
        "\n",
        "    if row['monthly_income'] == profile['monthly_income'].max():\n",
        "        names[cid] = 'High Earner'\n",
        "    elif row['monthly_expense_total'] == profile['monthly_expense_total'].max():\n",
        "        names[cid] = 'Big Spender'\n",
        "    elif row['debt_to_income_ratio'] == profile['debt_to_income_ratio'].max():\n",
        "        names[cid] = 'Debt Heavy'\n",
        "    else:\n",
        "        names[cid] = 'Balanced'\n",
        "\n",
        "# Add names\n",
        "df_clust['Cluster_Name'] = df_clust['Cluster'].map(names)\n",
        "\n",
        "# OUTPUT 🔥\n",
        "print(\"\\nCluster Summary:\")\n",
        "for cid in names:\n",
        "    count = (df_clust['Cluster']==cid).sum()\n",
        "    print(f\"Cluster {cid} ({names[cid]}): {count}\")\n",
        "\n",
        "# Visualization\n",
        "fig, ax = plt.subplots(1,3, figsize=(15,5))\n",
        "\n",
        "# 1. Income vs Expense\n",
        "for cid, grp in df_clust.groupby('Cluster'):\n",
